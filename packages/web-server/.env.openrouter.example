# OpenRouter 配置示例
# 使用此配置文件快速开始使用 OpenRouter
# 
# 使用方法：
# 1. 复制此文件为 .env
# 2. 替换 your-openrouter-api-key 为你的真实 API Key
# 3. 运行 npm run dev 启动服务

# 服务器配置
PORT=3000
HOST=0.0.0.0

# 会话配置
SESSION_SECRET=qwen-code-secret-key-change-this-in-production
MAX_SESSIONS=100
SESSION_TIMEOUT=3600000

# 工作区配置
WORKSPACE_ROOT=.

# CORS 配置
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# OpenRouter API 配置
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# 可选：如果你想在日志中看到更多信息
# DEBUG=qwen-code:*
