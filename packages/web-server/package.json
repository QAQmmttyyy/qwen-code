{
  "name": "@qwen-code/web-server",
  "version": "0.1.1",
  "description": "Qwen Code Web Server - Backend service for web-based agent interaction",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QwenLM/qwen-code.git"
  },
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "qwen-server": "dist/index.js"
  },
  "scripts": {
    "build": "node ../../scripts/build_package.js",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "debug": "node --inspect-brk dist/index.js",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:ci": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@qwen-code/qwen-code-core": "file:../core",
    "express": "^5.1.0",
    "cors": "^2.8.5",
    "express-session": "^1.18.1",
    "ws": "^8.18.0",
    "uuid": "^9.0.1",
    "dotenv": "^17.1.0",
    "compression": "^1.7.4",
    "helmet": "^8.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/express-session": "^1.18.1",
    "@types/node": "^20.11.24",
    "@types/ws": "^8.5.10",
    "tsx": "^4.20.3",
    "typescript": "^5.3.3",
    "vitest": "^3.1.1"
  },
  "engines": {
    "node": ">=20"
  }
}
